{
  "name": "dsh-finance",
  "version": "0.1.0",
  "description": "财务自由 · DSH 插件：左侧栏一个入口，内置整理好的投资书单、纪录片、美股博主与 Web3 工具资料库，可搜索、可标记进度、可写笔记。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "gallery",
    "skills",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": ["dsh-plugin", "deepseek-harness", "dsh", "finance", "invest", "financial-freedom"],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": [] }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "license": "MIT"
}
